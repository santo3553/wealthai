// Prisma schema for SWISH Used Smartphone E-Commerce Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id          String   @id @default(cuid())
  brand       String   // Apple, Samsung, Google
  modelName   String   // iPhone 15 Pro, Galaxy S24 Ultra
  slug        String   @unique
  basePrice   Float
  description String
  specsJson   String   // JSON string of specs (Display, Chipset, Camera, etc.)
  imagesJson  String   // JSON array of image URLs
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryItems DeviceInventoryItem[]
}

model DeviceInventoryItem {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imeiOrSerial    String   @unique
  storage         String   // 128GB, 256GB, 512GB, 1TB
  color           String   // Natural Titanium, Phantom Black, etc.
  conditionGrade  String   // PRISTINE, GOOD, FAIR
  batteryHealth   Int      // 94 for 94%
  carrierLock     String   @default("Unlocked")
  salePrice       Float
  stockStatus     String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  inspectionNotes String?
  imagesJson      String?  // JSON array of device physical condition photos
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems      OrderItem[]
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique // e.g. SW-2026-8912
  customerName          String
  customerEmail         String
  customerPhone         String
  shippingAddress       String
  totalAmount           Float
  paymentMethod         String      // STRIPE_CARD, CASH_ON_DELIVERY, BANK_TRANSFER
  paymentStatus         String      @default("PENDING") // PENDING, PAID, FAILED
  orderStatus           String      @default("PENDING_REVIEW") // PENDING_REVIEW, DIAGNOSTIC_PACKAGING, SHIPPED, DELIVERED, CANCELLED
  carrierTrackingNumber String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items                 OrderItem[]
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   DeviceInventoryItem @relation(fields: [inventoryItemId], references: [id])
  price           Float
  createdAt       DateTime            @default(now())
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  fullName            String
  role                String    @default("SUPER_ADMIN") // SUPER_ADMIN, OPERATIONS_MANAGER
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
